<!-- Integrar en ossec_config del MANAGER. No duplicar command si ya existe.
     El endpoint Linux usa firewall-drop (iptables). No aplicar a la regla D2.
     5763 es el ejemplo oficial; confirmar regla real de sus logs en logtest. -->
<command>
  <name>firewall-drop</name>
  <executable>firewall-drop</executable>
  <timeout_allowed>yes</timeout_allowed>
</command>
<active-response>
  <disabled>no</disabled>
  <command>firewall-drop</command>
  <location>local</location>
  <rules_id>5763,5712</rules_id>
  <timeout>60</timeout>
</active-response>
