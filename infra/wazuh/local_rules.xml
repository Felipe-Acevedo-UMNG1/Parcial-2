<!-- Integrar este grupo en el archivo local_rules.xml del servidor Wazuh. -->
<group name="mesa_ayuda,authentication_failed,">
  <rule id="100120" level="5">
    <decoded_as>mesa-ayuda-auth</decoded_as>
    <description>Mesa de Ayuda: intento de autenticación fallido desde $(srcip)</description>
  </rule>
  <rule id="100121" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100120</if_matched_sid>
    <same_srcip />
    <description>Mesa de Ayuda: cinco intentos fallidos en 60 segundos desde $(srcip)</description>
  </rule>
</group>
